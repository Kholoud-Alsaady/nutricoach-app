# -----------------------------------------------------------------------------
# NutriCoach environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. Only NEXT_PUBLIC_* values reach the browser.
# -----------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the seed script and the "Reset demo" button.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Postgres connection string (Project Settings -> Database -> URI).
# If set, `npm run db:setup` applies supabase/schema.sql for you.
# Otherwise paste supabase/schema.sql into the Supabase SQL editor.
SUPABASE_DB_URL=

# Google Gemini (server-only). Leave empty to use the built-in rule-based agent,
# which calls exactly the same tools so the demo works offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Model pricing in USD per 1M tokens. Seeded into the ai_model_pricing table and
# editable by the gym admin. Check https://ai.google.dev/gemini-api/docs/pricing
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50

# Demo Mode: shows the one-click role selector on the landing page.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=nutricoach-demo-2026
